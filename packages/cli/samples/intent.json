{
  "concepts": [
    { "name": "Order",    "kind": "aggregate-root", "attributes": ["id", "customerId", "total", "status", "placedAt"], "dependsOn": ["Customer"] },
    { "name": "Customer", "kind": "aggregate-root", "attributes": ["id", "name", "email"] },
    { "name": "Product",  "kind": "aggregate-root", "attributes": ["id", "name", "price", "sku"] },
    { "name": "Payment",  "kind": "aggregate-root", "attributes": ["id", "orderId", "amount", "method"], "dependsOn": ["Order"] },
    { "name": "Shipment", "kind": "aggregate-root", "attributes": ["id", "orderId", "address", "carrier"], "dependsOn": ["Order"] },
    { "name": "Refund",   "kind": "entity",         "attributes": ["id", "paymentId", "amount"], "dependsOn": ["Payment"] }
  ],
  "events": [
    { "name": "OrderPlaced",     "aggregate": "Order",    "trigger": "place()",   "properties": ["orderId", "total"] },
    { "name": "OrderShipped",    "aggregate": "Order",    "trigger": "ship()",    "properties": ["orderId"] },
    { "name": "PaymentCaptured", "aggregate": "Payment",  "trigger": "capture()", "properties": ["paymentId", "amount"] },
    { "name": "RefundIssued",    "aggregate": "Refund",   "trigger": "issue()",   "properties": ["refundId", "amount"] }
  ],
  "stateTransitions": [
    { "aggregate": "Order",   "from": "∅",       "to": "Placed",   "trigger": "place()",   "event": "OrderPlaced" },
    { "aggregate": "Order",   "from": "Placed",  "to": "Shipped",  "trigger": "ship()",    "event": "OrderShipped" },
    { "aggregate": "Payment", "from": "∅",       "to": "Captured", "trigger": "capture()", "event": "PaymentCaptured" }
  ]
}
