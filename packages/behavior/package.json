    "@octokit/rest": "^22.0.1",
    "commander": "^15.0.0",
    "dotenv": "^17.4.2",
    "mysql2": "^3.22.5",
    "pg": "^8.22.0",
    "pino": "^10.3.1",
    "playwright": "^1.61.0",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/pg": "^8.20.0",
    "tsx": "^4.19.2"
  },
  "private": true
